# HTTP: solo redirige a HTTPS.
server {
  listen 80 default_server;
  server_name _;
  return 301 https://${CARGO_DOMAIN}$request_uri;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${CARGO_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${CARGO_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${CARGO_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  # Hacia otros dominios solo va el origen. Los servidores de mapas (OpenStreetMap) piden Referer.
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  set $api http://api:8000;
  set $frontend http://frontend:3000;

  location = /health { proxy_pass $api/health/ready; }

  location /api/v1/ws {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
  }

  # Endpoints públicos sensibles con límite por IP (las zonas están en nginx.prod.conf).
  location = /api/v1/auth/login {
    limit_req zone=auth_login burst=5 nodelay;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location ~ ^/api/v1/auth/(register|password-reset/) {
    limit_req zone=auth_account burst=3 nodelay;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Respuesta 429 con el mismo formato de error de la API, para que el front muestre el mensaje.
  error_page 429 = @rate_limited;
  location @rate_limited {
    default_type application/json;
    add_header Retry-After 60 always;
    return 429 '{"error":{"code":"rate_limited","message":"Demasiados intentos desde tu conexión. Espera un minuto y vuelve a intentarlo."}}';
  }

  location /api/ {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location / {
    proxy_pass $frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
