# ---------------------------------------------------------------------------
# Configuración del backend CarGO v2. Copiar a `.env` y cambiar todos los secretos.
# `.env` está en .gitignore: nunca subir credenciales reales.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- PostgreSQL / PostGIS -----------------------------------------------------
POSTGRES_USER=cargo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=cargo
# Se usa cuando la API corre directo en la máquina (fuera de Docker):
DATABASE_URL=postgresql+asyncpg://cargo:change-me-postgres@127.0.0.1:5432/cargo

# --- Autenticación -------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# true en producción (solo HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost

# --- Broker MQTT IoT (frontera externa, TLS 8883) -------------------------------
MQTT_IOT_HOST=127.0.0.1
MQTT_IOT_PORT=1883
MQTT_IOT_USERNAME=cargo-ingestion
MQTT_IOT_INGESTION_PASSWORD=change-me-iot-ingestion
MQTT_IOT_PASSWORD=change-me-iot-ingestion
MQTT_IOT_TLS=false
# Credenciales de los dispositivos en el broker: CODIGO:clave,CODIGO:clave
MQTT_IOT_DEVICE_ACCOUNTS=DEV-GW-003:change-me-device-003,DEV-GW-011:change-me-device-011
MQTT_IOT_TLS_HOSTNAME=mqtt-iot

# --- Broker MQTT interno (solo red privada) -------------------------------------
MQTT_INTERNAL_HOST=127.0.0.1
MQTT_INTERNAL_PORT=1884
MQTT_INTERNAL_USERNAME=cargo-internal
MQTT_INTERNAL_PASSWORD=change-me-internal-bus

# --- Mapas: solo búsqueda de direcciones ---------------------------------------------
# CarGO no planifica rutas: un viaje es origen + destino. Los mapas solo sirven para buscar direcciones.
# Búsqueda de direcciones:  mapbox (necesita MAPBOX_TOKEN) | photon (OpenStreetMap)
# El servidor público de Photon es para desarrollo y demos; en producción: Mapbox o uno propio.
MAPBOX_TOKEN=
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# --- Telegram Bot API ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Políticas de monitoreo ---------------------------------------------------------
LIVE_TOLERANCE_SECONDS=60
MAX_FUTURE_SKEW_SECONDS=120
DEVICE_ONLINE_WINDOW_SECONDS=180
TRIP_REANNOUNCE_INTERVAL_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=3
# Hora local en los mensajes de Telegram (en BD todo queda en UTC)
DISPLAY_TIMEZONE=America/Lima

# --- Datos de prueba (scripts/seed_dev_data.py) --------------------------------------
SEED_ADMIN_EMAIL=admin@cargo.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_OPERATOR_EMAIL=operador@cargo.local
SEED_OPERATOR_PASSWORD=change-me-operator-password

# --- Perfil opcional de compose --------------------------------------------------------
FRONTEND_PATH=../cargo-front
# Opcional: chat que recibe los mensajes de prueba de scripts/telegram_check.py
TELEGRAM_TEST_CHAT_ID=
